{
  "name": "statsbot_10_bucket_london",
  "timezone": "Europe/London",
  "description": "Data-driven stats_bot London session map. Uses variable-width buckets with ASIA pre-active, Europe open/midday, US open early/late, and combined afterhours.",
  "rules": [
    {
      "session_bucket": "ASIA_DEEP_LOW",
      "start_hour": 0,
      "end_hour": 2
    },
    {
      "session_bucket": "ASIA_PRE_ACTIVE",
      "start_hour": 2,
      "end_hour": 4
    },
    {
      "session_bucket": "ASIA_CORE_HANDOVER",
      "start_hour": 4,
      "end_hour": 8
    },
    {
      "session_bucket": "EUROPE_OPEN",
      "start_hour": 8,
      "end_hour": 10
    },
    {
      "session_bucket": "EUROPE_MIDDAY",
      "start_hour": 10,
      "end_hour": 12
    },
    {
      "session_bucket": "US_PREOPEN",
      "start_hour": 12,
      "end_hour": 14
    },
    {
      "session_bucket": "US_OPEN_EARLY",
      "start_hour": 14,
      "end_hour": 16
    },
    {
      "session_bucket": "US_OPEN_LATE",
      "start_hour": 16,
      "end_hour": 18
    },
    {
      "session_bucket": "US_LATE_CORE",
      "start_hour": 18,
      "end_hour": 20
    },
    {
      "session_bucket": "US_AFTERHOURS",
      "start_hour": 20,
      "end_hour": 24
    }
  ]
}
