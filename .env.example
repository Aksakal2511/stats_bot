# Stats Bot local environment template.
#
# Copy this file to `.env` and fill in your own credentials:
#
#   cp .env.example .env
#
# Never commit `.env`.

# ---------------------------------------------------------------------------
# Polymarket credentials
# ---------------------------------------------------------------------------
# Required for live trading. Keep these blank in git.
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_SIGNATURE_TYPE=1

# ---------------------------------------------------------------------------
# Runtime mode and sizing
# ---------------------------------------------------------------------------
# CLI flags override this:
#   python3 run_bot.py --paper
#   python3 run_bot.py --live
STATS_PAPER_TRADING=false
STATS_STAKE_MODE=ladder_shares
STATS_STAKE_USD=5
STATS_MIN_ORDER_SIZE_FALLBACK=5
STATS_STARTING_BALANCE=1000

# ---------------------------------------------------------------------------
# Active production strategy
# ---------------------------------------------------------------------------
# Active bundle uses:
#   btc_linear_z_price_bucket value model
#   dynamic edge selector:
#     day_group_time_contradiction_vol_q4 when support >= 50
#     fallback -> day_group_time_contradiction -> day_group_time
# The selector artifact is referenced by entry_profiles.json next to the
# strategy manifest; no separate env var is needed.
STATS_MACRO_POLICY_BUNDLE=strategy/btc_linear_z_pb_asym_hl120_excl_apr29_may18_c04_m06_jul25_v1/strategy_manifest.json

# Retained legacy policy/exit files. The current bundle is the active entry
# strategy, but these paths are kept aligned with the live environment.
STATS_POLICY_FILE=strategy/policy_cube/policy_cube_dual_side_hold_values_offset250_12bucket_2h_cb_sources.jsonl
STATS_ENTRY_EDGE_THRESHOLDS_FILE=strategy/entry_policy/offset250_12bucket_2h_cb_sources_hold_value_style_thresholds.csv
STATS_EXIT_THRESHOLDS_FILE=strategy/exit_policy/offset250_12bucket_2h_hold_exit_thresholds.csv
STATS_VOLATILITY_EDGES_FILE=strategy/bucket_config/volatility_bucket_edges_offset250_12bucket_2h_cb_sources.json
STATS_EXIT_POLICY_MODE=hold_to_resolution

# ---------------------------------------------------------------------------
# Entry/execution settings
# ---------------------------------------------------------------------------
STATS_EXECUTION_MODE=event_driven_ws
STATS_PAPER_FILL_MODEL=fast_limit

STATS_MIN_ENTRY_PRICE=0.20
STATS_MAX_ENTRY_PRICE=0.80
STATS_WEEKEND_MIN_ENTRY_PRICE=0.20
STATS_WEEKEND_MAX_ENTRY_PRICE=0.80
STATS_ENTRY_START_BLOCK_SECONDS=45
STATS_ENTRY_MIN_TTE_SECONDS=45
STATS_ENTRY_MAX_TTE_SECONDS=265
STATS_COOLDOWN_SECONDS=4
STATS_MAKER_MIN_SPREAD_TICKS=1
STATS_ENTRY_QUOTE_MAX_AGE_SECONDS=1.5
STATS_POLICY_NO_LONGER_VIABLE_LATCH_SECONDS=1.5
STATS_ENTRY_RESTING_MAX_AGE_SECONDS=3.0
STATS_ENTRY_STALE_QUOTE_MAX_TICKS=2
STATS_ENTRY_STALE_QUOTE_GRACE_SECONDS=0.4
STATS_SURPLUS_ADAPTIVE_ENTRY_ENABLED=true
STATS_SURPLUS_ADAPTIVE_MIN_EDGE_SURPLUS=0.015
STATS_SURPLUS_ADAPTIVE_STEP_EDGE_SURPLUS=0.010
STATS_SURPLUS_ADAPTIVE_EXTRA_TICKS=2
STATS_LIVE_ENTRY_RETRY_COOLDOWN_SECONDS=2
STATS_LIVE_MAX_ENTRY_ATTEMPTS_PER_WINDOW=3
STATS_LIVE_WALLET_RECONCILE_TOLERANCE_USD=0.02
STATS_EXIT_RETRY_CADENCE_SECONDS=1.0
STATS_DUST_SHARE_THRESHOLD=0.01

# ---------------------------------------------------------------------------
# FFM signed-volume hedge defence
# ---------------------------------------------------------------------------
STATS_PRESSURE_DEFENCE_ENABLED=true
STATS_FFM_MIN_HELD_MID=0.75
STATS_FFM_MAX_HELD_MID=1.00
STATS_FFM_ARM_TTE_SECONDS=60
STATS_FFM_TRIGGER_TTE_SECONDS=60
STATS_FFM_SIGNED_VOLUME_LOOKBACK_SECONDS=40
STATS_FFM_ADVERSE_VOLUME_BTC=5.0
STATS_PRESSURE_HEDGE_FRACTION=1.0
STATS_PRESSURE_HEDGE_LIMIT_PRICE=0.99

# ---------------------------------------------------------------------------
# Reference feeds
# ---------------------------------------------------------------------------
STATS_BINANCE_SPOT_FEED_ENABLED=true
STATS_BINANCE_SPOT_TRIGGER_ENABLED=false
STATS_BINANCE_PERP_FEED_ENABLED=false
STATS_BINANCE_PERP_TRIGGER_ENABLED=false
STATS_PM_CHAINLINK_FEED_ENABLED=false

# ---------------------------------------------------------------------------
# Risk controls
# ---------------------------------------------------------------------------
# Blocks new entries when Coinbase BPS contradicts the current PM YES price.
# Keep disabled for the current live strategy; the code path remains available.
STATS_BPS_YES_GUARD_ENABLED=false

# Latches off new entries after this realised-PnL drawdown from session peak.
# Zero disables the kill switch.
STATS_PEAK_DRAWDOWN_KILL_USD=0

# ---------------------------------------------------------------------------
# Loop/dashboard/logging
# ---------------------------------------------------------------------------
STATS_POLL_INTERVAL_SECONDS=0.5
STATS_STATUS_INTERVAL_SECONDS=2
STATS_BALANCE_REFRESH_SECONDS=15
STATS_OBSERVE_FIRST_WINDOW=false
STATS_LOG_DIR=logs

# Optional: stop after N seconds for smoke tests. Leave blank for normal runs.
STATS_MAX_LOOP_SECONDS=
