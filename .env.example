# Stats Bot local environment template.
#
# Copy this file to `.env` and fill in your own credentials:
#
#   cp .env.example .env
#
# Never commit `.env`.

# ---------------------------------------------------------------------------
# Polymarket credentials
# ---------------------------------------------------------------------------
# Required for live trading.
# Paper mode can run without private credentials for most public-data tests.
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_SIGNATURE_TYPE=1
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# CLI flags override this:
#   python3 run_bot.py --paper
#   python3 run_bot.py --live
STATS_PAPER_TRADING=true

# ---------------------------------------------------------------------------
# Active production strategy
# ---------------------------------------------------------------------------
# This is the current active bundle. It is trained through 2026-07-13 and is
# the only strategy artifact required for normal live/paper running.
STATS_MACRO_POLICY_BUNDLE=strategy/z6_move_dz_b11_w4_s50_wd120_we120_no_session_c05_m05_v1/policy_bundle.json

# Active strategy shape. The bot intentionally refuses to start if these drift
# from the frozen bundle. Use ladder_shares instead of min_order_size to opt
# into the bankroll ladder sizing mode.
STATS_STAKE_MODE=min_order_size
STATS_MIN_ORDER_SIZE_FALLBACK=5
STATS_MIN_ENTRY_PRICE=0.20
STATS_MAX_ENTRY_PRICE=0.80
STATS_WEEKEND_MIN_ENTRY_PRICE=0.20
STATS_WEEKEND_MAX_ENTRY_PRICE=0.80
STATS_ENTRY_START_BLOCK_SECONDS=45
STATS_ENTRY_MIN_TTE_SECONDS=45
STATS_ENTRY_MAX_TTE_SECONDS=265
STATS_EXIT_POLICY_MODE=hold_to_resolution

# Paper-only balance display/simulation value.
STATS_STARTING_BALANCE=1000

# Ignored by the active min_order_size strategy, but left for fixed_usd tests.
STATS_STAKE_USD=5

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# event_driven_ws is the normal runtime. legacy_polling is the rollback mode.
STATS_EXECUTION_MODE=event_driven_ws

# Paper mode should use fast_limit when comparing against live mechanics.
STATS_PAPER_FILL_MODEL=fast_limit

# Live retry/reconciliation behaviour.
STATS_COOLDOWN_SECONDS=10
STATS_LIVE_ENTRY_RETRY_COOLDOWN_SECONDS=8
STATS_LIVE_MAX_ENTRY_ATTEMPTS_PER_WINDOW=2
STATS_LIVE_WALLET_RECONCILE_TOLERANCE_USD=0.02
STATS_ENTRY_QUOTE_MAX_AGE_SECONDS=1.5
STATS_DUST_SHARE_THRESHOLD=0.01

# The active fast path is ask + 1 tick, with the edge still required to survive
# at that limit. This is a code constant, not an environment variable.
STATS_MAKER_MIN_SPREAD_TICKS=1

# ---------------------------------------------------------------------------
# FFM signed-volume hedge defence
# ---------------------------------------------------------------------------
# Live defensive hedge for high-confidence BTC 5m positions when Binance spot
# signed taker flow pushes against the held favourite into settlement.
STATS_PRESSURE_DEFENCE_ENABLED=false
STATS_FFM_MIN_HELD_MID=0.75
STATS_FFM_MAX_HELD_MID=1.00
STATS_FFM_ARM_TTE_SECONDS=60
STATS_FFM_TRIGGER_TTE_SECONDS=40
STATS_FFM_SIGNED_VOLUME_LOOKBACK_SECONDS=30
STATS_FFM_ADVERSE_VOLUME_BTC=8.0
STATS_PRESSURE_HEDGE_FRACTION=1.0
STATS_PRESSURE_HEDGE_LIMIT_PRICE=0.99

# ---------------------------------------------------------------------------
# Risk controls
# ---------------------------------------------------------------------------
# Latches off new entries after this realised-PnL drawdown from session peak.
# It does not force-sell an existing position.
STATS_PEAK_DRAWDOWN_KILL_USD=15

# Observe the first newly discovered live window without entering.
# Leave unset for mode-aware defaults: live=true, paper=false.
# STATS_OBSERVE_FIRST_WINDOW=true

# ---------------------------------------------------------------------------
# Loop/dashboard/logging
# ---------------------------------------------------------------------------
STATS_POLL_INTERVAL_SECONDS=0.5
STATS_STATUS_INTERVAL_SECONDS=2
STATS_BALANCE_REFRESH_SECONDS=15
STATS_LOG_DIR=logs

# Optional: stop after N seconds for smoke tests. Leave blank for normal runs.
STATS_MAX_LOOP_SECONDS=

# ---------------------------------------------------------------------------
# Legacy optional files
# ---------------------------------------------------------------------------
# These are not needed for the active hold_to_resolution strategy. Only set them
# if you deliberately enable old/legacy exit research modes.
# STATS_POLICY_FILE=strategy/policy_cube/policy_cube_dual_side_hold_values_offset250_12bucket_2h_cb_sources.jsonl
# STATS_ENTRY_EDGE_THRESHOLDS_FILE=strategy/entry_policy/offset250_12bucket_2h_cb_sources_hold_value_style_thresholds.csv
# STATS_EXIT_THRESHOLDS_FILE=strategy/exit_policy/offset250_12bucket_2h_hold_exit_thresholds.csv
# STATS_VOLATILITY_EDGES_FILE=strategy/bucket_config/volatility_bucket_edges_offset250_12bucket_2h_cb_sources.json
